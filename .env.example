# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Redis — password MUST be set; Redis is bound to the Docker-internal network only.
# Use a long random string: openssl rand -hex 32
REDIS_PASSWORD=changeme_use_a_strong_random_password_here
REDIS_URL=redis://:changeme_use_a_strong_random_password_here@redis:6379

# SQLite database path (container path; mapped via volume)
DB_PATH=/app/data/emailvalidation.db
